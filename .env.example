# Required environment variables — copy to .env.local and fill in real values

# OpenAI API Key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# MongoDB connection string — get from MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_chat?retryWrites=true&w=majority

# MongoDB database name
MONGODB_DB=ai_chat
